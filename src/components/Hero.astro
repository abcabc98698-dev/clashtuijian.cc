---
import { site, hero } from '../config';
import { asset, splitAmp } from '../utils';
const parts = splitAmp(site.name);
---
<section id={hero.id} class="pin hero dark" data-scene="pin" data-var="hp" aria-labelledby="hero-heading">
  <div class="stage">
    <div class="hero-photo lighten">
      <img
        src={asset(hero.image)}
        alt={hero.imageAlt}
        width={hero.imageWidth}
        height={hero.imageHeight}
        fetchpriority="high"
        decoding="async"
      >
    </div>
    <div class="hero-wash" aria-hidden="true" data-w="0.4 0.4"></div>

    <div class="hero-copy">
      <p class="hero-line" data-split="0.42 0.3 0.06">{hero.line}</p>
      <p class="hero-sub rv" data-w="0.7 0.22">{hero.sub}</p>
      <div class="btn-row rv" data-w="0.8 0.2">
        <a
          class="btn btn-primary"
          href={hero.primary.href}
          target={hero.primary.external ? '_blank' : undefined}
          rel={hero.primary.external ? 'nofollow sponsored noopener' : undefined}
        >
          {hero.primary.label}
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>

    <div class="curtain" data-w="0 0.62" data-ease="inout">
      <div class="curtain-mark" data-mark aria-hidden="true"></div>
      <div class="kicker">{hero.kicker}</div>
      <h1 id="hero-heading" class="wordmark">{parts.map((p, i) => <>{i > 0 && <span>&amp;</span>}{p}</>)}</h1>
      <div class="scroll-cue" aria-hidden="true">{hero.scrollCue}</div>
      <div class="rule" aria-hidden="true"></div>
    </div>
  </div>
</section>
