---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import GuidesNav from '../../components/GuidesNav.astro';
import { brands, AFFILIATE_DISCLOSURE } from '../../data/brands';
import { canonicalUrl } from '../../utils';
import { site } from '../../config';

const pageTitle = '2026 机场品牌库 (42家全收录)：IEPL专线筛选、测速截图与对比 | ClashTuijian.cc';
const pageDesc =
  'ClashTuijian.cc 完整收录 42 家机场品牌数据库：支持按 Clash 通用订阅、免配置专属客户端、永久不限时流量包、5.6元平价档及 2026-08-11 真实测速截图实时检索筛选。第一主推 2020 老牌双线光速云。';

const origin = Astro.site ?? site.url;
const pageUrl = canonicalUrl('/brands', origin);

const directorySchema = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#collection`,
    name: pageTitle,
    description: pageDesc,
    url: pageUrl,
    mainEntity: {
      '@id': `${pageUrl}#brand-itemlist`,
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: canonicalUrl('/', origin),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '42家机场品牌库',
        item: pageUrl,
      },
    ],
  },
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#brand-itemlist`,
    name: '2026 42家 Clash 机场品牌库完整清单',
    numberOfItems: brands.length,
    itemListElement: brands.map((b) => ({
      '@type': 'ListItem',
      position: b.rank,
      name: b.name,
      description: b.summary,
      url: canonicalUrl(`/brands/${b.slug}`, origin),
    })),
  },
];

const measuredCount = brands.filter((b) => Boolean(b.measuredPng)).length;
const unlimitedCount = brands.filter((b) => b.hasUnlimitedPack).length;
const clashSubCount = brands.filter((b) => b.clientMode === 'both' || b.clientMode === 'clash-sub').length;
---
<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={['机场品牌库', '42家机场对比', 'Clash机场大全', 'IEPL机场筛选', '光速云', '便宜机场排行榜']}
  customSchema={directorySchema}
>
  <Nav />
  <main id="main-content" class="subpage-main">
    <section class="wrap dir-hero" aria-labelledby="dir-heading">
      <nav class="breadcrumb" aria-label="面包屑导航">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">42家机场品牌库</span>
      </nav>

      <GuidesNav active="brands" />

      <div class="kicker">Dark Network Observatory // Provider Database</div>
      <h1 id="dir-heading" class="h-section">2026 机场品牌库与实测检索中心</h1>
      <p class="lede dir-lede">
        本数据库完整收录 <strong>{brands.length} 家</strong> 机场结构化档案（其中 <strong>{measuredCount} 家</strong> 附带 2026-08-11 原始测速 PNG 截图、<strong>{clashSubCount} 家</strong> 支持 Clash / Shadowrocket 订阅导入、<strong>{unlimitedCount} 家</strong> 提供一次性永久不限时流量包）。所有无可靠实测的字段均严格标记为「待核实」。
      </p>

      <!-- Data Status & Disclosure Banner -->
      <div class="status-legend" role="region" aria-label="数据状态说明与合规披露">
        <div class="legend-badges">
          <span class="status-pill status-pill--measured">● Measured · 含 2026-08-11 实测截图 (17家)</span>
          <span class="status-pill status-pill--vendor">● Vendor · 2026-10 品牌公开资料 (11家)</span>
          <span class="status-pill status-pill--historical">● Archive · 2026-08 历史归档记录 (14家)</span>
        </div>
        <p class="legend-note">
          {AFFILIATE_DISCLOSURE} 测速图仅代表当次测试时间点与测试网络结果，建议先用月付或小包实测本地晚高峰。
        </p>
      </div>

      <!-- Filter & Search Console -->
      <div class="filter-console" role="search" aria-label="品牌库搜索与筛选">
        <div class="filter-row-top">
          <div class="search-box">
            <label for="brand-search" class="sr-only">搜索品牌名称、协议、线路或地区</label>
            <input
              id="brand-search"
              type="search"
              placeholder="搜索品牌名（如：光速云、飞猫云）、协议（VLESS/Trojan/Hysteria）、线路（IEPL/IPLC）或地区..."
              autocomplete="off"
            >
          </div>
          <div class="sort-box">
            <label for="brand-sort">排序方式：</label>
            <select id="brand-sort">
              <option value="rank">综合推荐排序 (#1 光速云领衔)</option>
              <option value="price-asc">入门月均价：从低到高</option>
              <option value="measured-first">实测截图优先 (2026-08-11 PNG)</option>
            </select>
          </div>
        </div>

        <div class="filter-tags" role="group" aria-label="快捷筛选标签">
          <button type="button" class="filter-chip is-active" data-filter="all">全部品牌 ({brands.length})</button>
          <button type="button" class="filter-chip" data-filter="top10">Top 10 主力推荐 (10)</button>
          <button type="button" class="filter-chip" data-filter="clash">支持 Clash 通用订阅 ({clashSubCount})</button>
          <button type="button" class="filter-chip" data-filter="custom">免配置专属客户端</button>
          <button type="button" class="filter-chip" data-filter="unlimited">含永久不限时包 ({unlimitedCount})</button>
          <button type="button" class="filter-chip" data-filter="measured">含 2026-08-11 实测图 ({measuredCount})</button>
          <button type="button" class="filter-chip" data-filter="budget">¥5.6~¥8.5 平价入门</button>
        </div>

        <div class="filter-status-bar">
          <span id="filter-count">当前显示全部 {brands.length} 家机场品牌</span>
          <button type="button" id="filter-reset" class="btn-reset" hidden>重置筛选条件</button>
        </div>
      </div>
    </section>

    <!-- Brand Cards Grid -->
    <section class="wrap dir-grid-section" aria-label="机场品牌列表">
      <div id="brand-directory-grid" class="dir-grid">
        {brands.map((b) => (
          <article
            class:list={['dir-card', { 'dir-card--primary': b.isPrimaryPick }]}
            style={`--brand-accent: ${b.accent}`}
            data-rank={b.rank}
            data-price={b.minMonthlyPrice}
            data-top10={b.isTopTen ? '1' : '0'}
            data-clash={b.clientMode === 'both' || b.clientMode === 'clash-sub' ? '1' : '0'}
            data-custom={b.clientMode === 'custom-only' || b.clientMode === 'both' ? '1' : '0'}
            data-unlimited={b.hasUnlimitedPack ? '1' : '0'}
            data-measured={b.measuredPng ? '1' : '0'}
            data-budget={b.minMonthlyPrice <= 8.5 ? '1' : '0'}
            data-search={`${b.name} ${b.slug} ${b.badge} ${b.lineType} ${b.protocols.join(' ')} ${b.regions} ${b.promoCode} ${b.summary}`.toLowerCase()}
          >
            <div class="dir-card-top">
              <span class="dir-rank">#{String(b.rank).padStart(2, '0')}</span>
              <span class="dir-badge">{b.badge}</span>
              <span
                class:list={[
                  'dir-status-dot',
                  b.dataStatus === 'measured-plus-vendor'
                    ? 'is-measured'
                    : b.dataStatus === 'vendor'
                      ? 'is-vendor'
                      : 'is-historical',
                ]}
                title={
                  b.dataStatus === 'measured-plus-vendor'
                    ? '含 2026-08-11 原始测速 PNG + 品牌资料'
                    : b.dataStatus === 'vendor'
                      ? '2026-10 品牌公开资料'
                      : '2026-08 历史归档记录'
                }
              >
                {b.measuredPng ? 'Measured PNG' : b.dataStatus === 'vendor' ? 'Vendor Data' : 'Archive'}
              </span>
            </div>

            <h2 class="dir-card-title">
              <a href={`/brands/${b.slug}`}>{b.name}</a>
            </h2>
            <p class="dir-card-summary">{b.summary}</p>

            <dl class="dir-specs">
              <div>
                <dt>入门参考价</dt>
                <dd class="spec-highlight">{b.entryPriceText}</dd>
              </div>
              <div>
                <dt>专属优惠码</dt>
                <dd><code>{b.promoCode}</code></dd>
              </div>
              <div>
                <dt>线路与协议</dt>
                <dd>{b.lineType} · {b.protocols.join(' / ')}</dd>
              </div>
              <div>
                <dt>客户端兼容</dt>
                <dd>{b.clientText}</dd>
              </div>
            </dl>

            <div class="dir-tags">
              {b.hasUnlimitedPack && <span class="dir-tag dir-tag--accent">含永久不限时包</span>}
              {b.measuredPng && <span class="dir-tag dir-tag--green">附 2026-08-11 实测图</span>}
              <span class="dir-tag">核验：{b.verifiedDate}</span>
            </div>

            <div class="dir-card-actions">
              {b.registerUrl ? (
                <a
                  class="btn btn-primary"
                  href={b.registerUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                >
                  直达官网注册 →
                </a>
              ) : (
                <a class="btn btn-secondary" href="/brands/guangsuyun">
                  无独立入口 · 推荐光速云
                </a>
              )}
              <a class="btn btn-secondary" href={`/brands/${b.slug}`}>
                深度评测与套餐
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="dir-empty-state" class="dir-empty" hidden>
        <h3>未找到匹配的机场品牌</h3>
        <p>请尝试缩短搜索关键词（例如输入“IEPL”、“VLESS”或“光速云”），或点击下方按钮重置筛选条件。</p>
        <button type="button" id="empty-reset-btn" class="btn btn-primary">显示全部 42 家品牌</button>
      </div>

      <!-- Native Semantic HTML Table Summary for GEO & AI Search Extraction -->
      <details class="faq-item card elev-sm" style="margin-top: 36px;">
        <summary>展开完整二维参数表：42 家机场品牌价格、协议、永久流量包与数据核验状态速查表</summary>
        <div class="table-scroll" style="margin-top: 16px;">
          <table class="obs-table">
            <thead>
              <tr>
                <th scope="col">排名</th>
                <th scope="col">品牌名称</th>
                <th scope="col">运营年份</th>
                <th scope="col">线路与协议</th>
                <th scope="col">起步参考价</th>
                <th scope="col">永久包</th>
                <th scope="col">客户端模式</th>
                <th scope="col">数据口径</th>
              </tr>
            </thead>
            <tbody>
              {brands.map((b) => (
                <tr class:list={[{ 'is-primary-row': b.isPrimaryPick }]}>
                  <td>#{String(b.rank).padStart(2, '0')}</td>
                  <td><a href={`/brands/${b.slug}`}>{b.name}</a></td>
                  <td>{b.founded}</td>
                  <td>{b.lineType} ({b.protocols.join('/')})</td>
                  <td class="table-price">{b.entryPriceText}</td>
                  <td>{b.hasUnlimitedPack ? '✓ 有' : '—'}</td>
                  <td>{b.clientMode === 'custom-only' ? '专属客户端' : b.clientMode === 'both' ? '双模支持' : '通用订阅'}</td>
                  <td>{b.measuredPng ? '含2026实测图' : b.dataStatus === 'vendor' ? '官方参数' : '历史归档'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>

    <div class="outro">
      <Footer />
    </div>
  </main>

  <script>
    (() => {
      const searchInput = document.getElementById('brand-search') as HTMLInputElement | null;
      const sortSelect = document.getElementById('brand-sort') as HTMLSelectElement | null;
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
      const grid = document.getElementById('brand-directory-grid');
      const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.dir-card')) : [];
      const countEl = document.getElementById('filter-count');
      const resetBtn = document.getElementById('filter-reset');
      const emptyState = document.getElementById('dir-empty-state');
      const emptyResetBtn = document.getElementById('empty-reset-btn');

      let activeFilter = 'all';

      function applyFilterAndSort() {
        if (!grid) return;
        const q = (searchInput?.value || '').trim().toLowerCase();
        const sortBy = sortSelect?.value || 'rank';

        const sorted = [...cards].sort((a, b) => {
          const rankA = Number(a.dataset.rank || 999);
          const rankB = Number(b.dataset.rank || 999);
          const priceA = Number(a.dataset.price || 999);
          const priceB = Number(b.dataset.price || 999);
          const measA = Number(a.dataset.measured || 0);
          const measB = Number(b.dataset.measured || 0);

          if (sortBy === 'price-asc') {
            return priceA !== priceB ? priceA - priceB : rankA - rankB;
          }
          if (sortBy === 'measured-first') {
            return measA !== measB ? measB - measA : rankA - rankB;
          }
          return rankA - rankB;
        });

        let visibleCount = 0;
        for (const card of sorted) {
          grid.appendChild(card);
          const hay = card.dataset.search || '';
          const matchQuery = !q || hay.includes(q);
          let matchChip = true;
          if (activeFilter === 'top10') matchChip = card.dataset.top10 === '1';
          else if (activeFilter === 'clash') matchChip = card.dataset.clash === '1';
          else if (activeFilter === 'custom') matchChip = card.dataset.custom === '1';
          else if (activeFilter === 'unlimited') matchChip = card.dataset.unlimited === '1';
          else if (activeFilter === 'measured') matchChip = card.dataset.measured === '1';
          else if (activeFilter === 'budget') matchChip = card.dataset.budget === '1';

          const show = matchQuery && matchChip;
          card.hidden = !show;
          if (show) visibleCount++;
        }

        if (countEl) {
          countEl.textContent = `当前匹配显示 ${visibleCount} / ${cards.length} 家机场品牌`;
        }
        const isFiltered = Boolean(q) || activeFilter !== 'all' || sortBy !== 'rank';
        if (resetBtn) resetBtn.hidden = !isFiltered;
        if (emptyState) emptyState.hidden = visibleCount > 0;
      }

      searchInput?.addEventListener('input', applyFilterAndSort);
      sortSelect?.addEventListener('change', applyFilterAndSort);

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          for (const c of chips) c.classList.remove('is-active');
          chip.classList.add('is-active');
          activeFilter = chip.dataset.filter || 'all';
          applyFilterAndSort();
        });
      }

      const resetAll = () => {
        if (searchInput) searchInput.value = '';
        if (sortSelect) sortSelect.value = 'rank';
        activeFilter = 'all';
        for (const c of chips) {
          c.classList.toggle('is-active', c.dataset.filter === 'all');
        }
        applyFilterAndSort();
      };

      resetBtn?.addEventListener('click', resetAll);
      emptyResetBtn?.addEventListener('click', resetAll);
    })();
  </script>
</Layout>
